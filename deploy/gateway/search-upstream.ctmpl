# Generated by Consul Template from search-upstream.ctmpl. Do not edit.
# Only Search instances whose /health/ready check is passing are listed.
upstream search_backend {
{{- range service "search" }}
    server {{ .Address }}:{{ .Port }} max_fails=1 fail_timeout=2s;  # {{ .ID }}
{{- else }}
    server 127.0.0.1:1 down;  # no ready Search instance
{{- end }}
}